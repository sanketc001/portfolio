# Copy to .env.local for local development. Both values are optional.
# In production they come from GitHub repository variables (see README).

# URL of the deployed chat-proxy worker, e.g. https://portfolio-chat-proxy.<subdomain>.workers.dev
VITE_CHAT_ENDPOINT=

# Web3Forms access key for the contact form (https://web3forms.com).
# Without it, Contact shows a mailto button instead of the form.
VITE_WEB3FORMS_KEY=
